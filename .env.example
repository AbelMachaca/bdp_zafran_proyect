WC_STORE_URL=https://zafran.com.ar
WC_CONSUMER_KEY=ck_reemplazar
WC_CONSUMER_SECRET=cs_reemplazar
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Acceso al panel: obligatorio. En producción CLIENT_ORIGIN debe ser la URL HTTPS del frontend.
PANEL_USERNAME=
# Contraseña única y aleatoria de al menos 16 caracteres (máximo 1024).
PANEL_PASSWORD=

# PostgreSQL 17 · Easypanel
# Podés usar DATABASE_URL o las variables DB_* de abajo.
DATABASE_URL=
DB_HOST=bdp-cuentas_postgres-main
DB_PORT=5432
DB_NAME=bdp_zafran
DB_USER=zafran_app
DB_PASSWORD=reemplazar
DB_SSL=false

# Webhooks y automatizaciones. Dejá la fecha vacía hasta el momento de activación.
WC_WEBHOOK_SECRET=
AUTOMATIONS_ACTIVE_FROM=
EMBLUE_ENABLED=false
EMBLUE_POST_PURCHASE_ENABLED=false
EMBLUE_POST_PURCHASE_URL=
# Dejar vacío mientras el conector Data Lab use "Sin autenticación adicional".
EMBLUE_POST_PURCHASE_TOKEN=
# Completar al activar producción. Los trabajos anteriores quedan como vencidos y nunca se envían.
EMBLUE_POST_PURCHASE_ACTIVE_FROM=
EMBLUE_TIMEOUT_MS=12000
EMBLUE_MAX_ATTEMPTS=5
# Clave larga y aleatoria para proteger el envío de pruebas desde el panel.
AUTOMATION_TEST_SECRET=
